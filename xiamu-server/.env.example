# Remote backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8081
# 部署保护模式：跳过启动阶段的建表、补数据、导入和订单清理
PRESERVE_EXISTING_DATA=true
BACKEND_SESSION_SECRET=replace-this-secret-in-production
CONSOLE_STATIC_DIR=../xiamu-adminweb/dist

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
SUPERADMIN_PASSWORD=replace-this-superadmin-password

# Asset host used in exported product image URLs
PUBLIC_ASSET_BASE_URL=http://127.0.0.1:8081
# Beta 环境只使用模拟微信登录、模拟支付，并禁用线上微信订单同步
ALLOW_MOCK_WECHAT_LOGIN=true
WECHAT_PAY_MOCK_MODE=true
WECHAT_PAY_NOTIFY_URL=http://127.0.0.1:8081/api/pay/wechat/notify
WECHAT_ORDER_SYNC_ENABLED=false
# 微信商家转账专用回调，不能与普通微信支付回调共用
WECHAT_TRANSFER_NOTIFY_URL=http://127.0.0.1:8081/api/pay/wechat/transfer/notify
WECHAT_TRANSFER_SCENE_ID=1010
WECHAT_TRANSFER_USER_RECV_PERCEPTION=二手回收货款

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=miniprogram_db_beta
MYSQL_CONNECTION_LIMIT=10

# SF Express production pickup
SF_EXPRESS_PARTNER_ID=
SF_EXPRESS_CHECK_WORD=
SF_EXPRESS_ENDPOINT_URL=https://sfapi-sbox.sf-express.com/std/service
SF_EXPRESS_SIGN_MODE=md5-base64
SF_EXPRESS_TIMEOUT_MS=15000
SF_EXPRESS_USE_SANDBOX=true
SF_EXPRESS_SERVICE_CODE=EXP_RECE_CREATE_ORDER
SF_EXPRESS_DEFAULT_WEIGHT_KG=1
SF_EXPRESS_SENDER_NAME=
SF_EXPRESS_SENDER_PHONE=
SF_EXPRESS_SENDER_COMPANY=
SF_EXPRESS_SENDER_PROVINCE=
SF_EXPRESS_SENDER_CITY=
SF_EXPRESS_SENDER_DISTRICT=
SF_EXPRESS_SENDER_ADDRESS=

# Optional: mirror exported catalog files into the WeChat miniprogram repo
# Windows example:
# MINIPROGRAM_REPO_PATH=C:\Users\your-name\WeChatProjects\miniprogram-3
MINIPROGRAM_REPO_PATH=
