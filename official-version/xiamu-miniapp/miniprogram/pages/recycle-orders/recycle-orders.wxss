/* 回收订单页面布局与详情弹窗样式 */
page {
  height: 100%;
  background: #ffffff;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-shell {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  overflow: hidden;
}

.status-holder {
  width: 100%;
}

.top-bar,
.subpage-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 24rpx;
  flex-shrink: 0;
}

.top-bar-title,
.subpage-nav-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111111;
  line-height: 1.2;
}

.subpage-nav-title {
  flex: 1;
  text-align: center;
}

.subpage-nav-side {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.subpage-nav-side-right {
  justify-content: flex-end;
}

.subpage-nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 10rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.order-mode-scroll {
  margin: 4rpx 0 0;
  white-space: nowrap;
  flex-shrink: 0;
}

.order-mode-list {
  display: inline-flex;
  align-items: center;
  gap: 22rpx;
  padding-right: 20rpx;
}

.order-mode-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 78rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #2b313a;
  box-sizing: border-box;
}

.order-mode-item-active {
  background: #111111;
  color: #ffffff;
}

.order-mode-text {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.order-mode-progress {
  position: relative;
  height: 4rpx;
  margin: 10rpx 0 16rpx;
  border-radius: 999rpx;
  background: #eef0f4;
  overflow: hidden;
  flex-shrink: 0;
}

.order-mode-progress-thumb {
  position: absolute;
  top: 0;
  height: 100%;
  border-radius: 999rpx;
  background: #111111;
  transition: left 0.12s ease, width 0.12s ease;
}

.mode-notice {
  margin-top: 22rpx;
  flex-shrink: 0;
}

.mode-notice-text {
  display: block;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fff4cf 0%, #ffefb3 100%);
  color: #9b6a00;
  font-size: 28rpx;
  line-height: 1.5;
}

.cart-list {
  flex: 1;
  min-height: 0;
  padding: 26rpx 0 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.cart-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 188rpx;
  padding: 26rpx 22rpx 62rpx 20rpx;
  border: 1rpx solid #BEBEBE;
  background: #ffffff;
  border-radius: 26rpx;
  box-shadow: 0 10rpx 24rpx rgba(29, 35, 48, 0.05);
  box-sizing: border-box;
}

.cart-item-link {
  padding-right: 170rpx;
  padding-bottom: 82rpx;
  min-height: 214rpx;
  box-shadow: 0 10rpx 24rpx rgba(29, 35, 48, 0.05);
}

.cart-item-link .cart-copy {
  align-self: flex-start;
}

.cart-item-link .cart-title {
  position: absolute;
  top: 26rpx;
  left: 208rpx;
  max-width: 260rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cart-item-link .cart-subtitle {
  position: absolute;
  top: 119rpx;
  left: 208rpx;
  max-width: 260rpx;
  margin-top: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cart-item-link .cart-meta {
  position: absolute;
  top: 63rpx;
  left: 208rpx;
  margin-top: 0;
  white-space: nowrap;
}

.cart-item-link .cart-price-wrap {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  min-width: 0;
  min-height: 0;
  margin-right: 0;
  pointer-events: none;
}

.cart-item-settlement {
  padding-right: 24rpx;
  padding-bottom: 108rpx;
}

.cart-item + .cart-item {
  margin-top: 20rpx;
}

.recycle-item {
  gap: 16rpx;
}

.cart-select-button {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid #1677ff;
  background: rgba(22, 119, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.cart-select-button-active {
  background: #1677ff;
  box-shadow: 0 8rpx 18rpx rgba(22, 119, 255, 0.24);
}

.cart-select-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: transparent;
}

.cart-select-button-active .cart-select-dot {
  background: #ffffff;
}

.cart-cover {
  flex-shrink: 0;
  width: 116rpx;
  height: 116rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff7f50 0%, #ff4d4f 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.recycle-cover-red {
  background: linear-gradient(135deg, #ff3b30 0%, #bc0000 100%);
}

.recycle-cover-blue {
  background: linear-gradient(135deg, #2f7dff 0%, #1744b5 100%);
}

.recycle-cover-gray {
  background: linear-gradient(135deg, #b9bec9 0%, #7c8597 100%);
}

.recycle-cover-green {
  background: linear-gradient(135deg, #3cc980 0%, #0d8a4d 100%);
}

.cart-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cart-copy-hitbox {
  align-self: flex-start;
  max-width: 100%;
  display: flex;
  flex-direction: column;
}

.cart-title {
  font-size: 30rpx;
  line-height: 1.35;
  color: #202631;
  font-weight: 700;
}

.cart-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #9a9a9a;
}

.cart-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a92a3;
}

.cart-tag {
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.1;
}

.cart-tag-buy {
  background: #fff1f4;
  color: #e65677;
}

.cart-tag-recycle {
  background: #f4f7fb;
  color: #6b778d;
}

.cart-price-wrap {
  flex-shrink: 0;
  min-width: 126rpx;
  min-height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
}

.cart-price-wrap-link {
  margin-right: 24rpx;
}

.cart-price-wrap-link .cart-platform {
  position: absolute;
  top: 63rpx;
  right: 24rpx;
  margin-top: 0;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.cart-price-wrap-link .cart-price {
  position: absolute;
  top: 26rpx;
  right: 25rpx;
  white-space: nowrap;
}

.cart-price {
  font-size: 34rpx;
  line-height: 1.2;
  color: #eb1b23;
  font-weight: 700;
}

.recycle-status {
  font-size: 28rpx;
  color: #1f9d55;
  font-weight: 700;
}

.cart-platform {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9a9a9a;
}

.cart-platform-success {
  color: #1fa45f;
  font-weight: 700;
}

.cart-cover-image {
  display: block;
  overflow: hidden;
  background: #f1f3f6;
}

.cart-link-arrow {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
  font-weight: 700;
  color: #b4bac6;
  line-height: 1;
}

.recycle-delete-button {
  position: absolute;
  right: 18rpx;
  bottom: 4rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.recycle-item-server .recycle-delete-button {
  right: 5rpx;
}

.recycle-detail-button {
  position: absolute;
  right: 94rpx;
  bottom: 12rpx;
  z-index: 20;
  height: 52rpx;
  min-width: 128rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #d7dce5;
  border-radius: 8rpx;
  background: #ffffff;
  color: #303743;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 50rpx;
}

.recycle-detail-button::after {
  border: none;
}

.buy-action-group {
  position: absolute;
  right: 18rpx;
  bottom: 26rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
}

.settlement-action-group {
  position: absolute;
  right: 98rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.settlement-claim-button {
  min-width: 156rpx;
  height: 56rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.settlement-claim-button-disabled {
  background: #eef1f5;
  color: #9aa3b2;
}

.settlement-proof-button {
  position: absolute;
  right: 98rpx;
  bottom: 16rpx;
  min-width: 156rpx;
  height: 56rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #2468b8;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.buy-confirm-button {
  flex-shrink: 0;
  width: 128rpx;
  height: 48rpx;
  margin: 0;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #1677ff;
  border-radius: 24rpx;
  background: #ffffff;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.buy-confirm-button-disabled {
  border-color: #d7dce5;
  color: #9aa3b2;
  background: #f7f8fa;
}

.buy-delete-button {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.buy-delete-icon {
  width: 34rpx;
  height: 34rpx;
}

.recycle-cancel-button {
  position: absolute;
  right: 94rpx;
  bottom: 4rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.recycle-cancel-icon {
  width: 34rpx;
  height: 34rpx;
}

.recycle-delete-icon {
  width: 34rpx;
  height: 34rpx;
}

.empty-area {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-card {
  width: 100%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: none;
  box-sizing: border-box;
}

.empty-order-image {
  width: 180rpx;
  height: 180rpx;
  display: block;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #8b8b8b;
}

.recycle-selection-notice {
  margin: 0 -28rpx;
  padding: 0 28rpx 18rpx;
  background: #ffffff;
  flex-shrink: 0;
}

.recycle-selection-notice-text {
  display: block;
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  background: #ffd84d;
  color: #111111;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.summary-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0 18rpx;
  color: #8a8a8a;
  flex-shrink: 0;
}

.summary-row-subpage {
  margin: 0 -28rpx;
  padding: 22rpx 28rpx 18rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eceef3;
}

.summary-count {
  font-size: 32rpx;
  flex-shrink: 0;
}

.summary-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
  margin-left: auto;
}

.summary-action-button {
  min-width: 220rpx;
  height: 72rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: none;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.summary-action-button::after {
  border: none;
}

.checkout-button,
.clear-button {
  background: #111111;
  color: #ffffff;
}

.tab-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 0 env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -6rpx 16rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  color: #7f8591;
}

.tab-item-active {
  color: #1677ff;
}

.tab-icon-image {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.tab-text {
  margin-top: 10rpx;
  font-size: 26rpx;
}

.pickup-detail-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(17, 17, 17, 0.46);
  box-sizing: border-box;
}

.pickup-detail-modal {
  width: 100%;
  max-width: 620rpx;
  max-height: 78vh;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
  overflow-y: auto;
}

.purchase-detail-product {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f1f4;
}

.purchase-detail-cover {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #f0f1f4;
  object-fit: cover;
}

.purchase-detail-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  box-sizing: border-box;
  color: #8a92a3;
  font-size: 20rpx;
  text-align: center;
}

.purchase-detail-product-name {
  flex: 1;
  min-width: 0;
  color: #202631;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
  word-break: break-all;
}

.recycle-detail-product-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recycle-detail-modal {
  overflow: hidden;
}

.recycle-detail-scroll {
  width: 100%;
  height: 62vh;
}

.recycle-detail-product-summary {
  color: #8a92a3;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}

.recycle-detail-price {
  color: #d92d20;
  font-weight: 700;
}

.recycle-detail-option-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 12rpx;
}

.recycle-detail-option-line,
.recycle-detail-option-empty {
  display: block;
  color: #50555f;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: left;
  word-break: break-all;
}

.purchase-detail-modal .pickup-detail-row-column {
  display: block;
}

.purchase-detail-address {
  display: block;
  margin-top: 12rpx;
  text-align: left;
}

.purchase-detail-price {
  color: #d92d20;
  font-weight: 700;
}

.pickup-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pickup-detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111111;
}

.pickup-detail-close {
  flex-shrink: 0;
  color: #8a92a3;
  font-size: 24rpx;
}

.pickup-detail-product {
  display: block;
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.4;
  color: #202631;
  font-weight: 700;
}

.pickup-detail-status {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #2f7dff;
  font-size: 22rpx;
  font-weight: 700;
}

.pickup-detail-status + .pickup-detail-row {
  display: none;
}

.pickup-detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.pickup-detail-row-last {
  border-bottom: none;
}

.pickup-detail-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 26rpx;
  color: #2b313a;
}

.pickup-detail-value-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  gap: 18rpx;
}

.pickup-detail-value-wrap-multiline {
  justify-content: space-between;
}

.pickup-detail-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  line-height: 1.6;
  color: #50555f;
  word-break: break-all;
}

.pickup-detail-value-multiline {
  text-align: left;
}

.pickup-detail-copy {
  flex-shrink: 0;
  color: #2f7dff;
  font-size: 22rpx;
  font-weight: 700;
}

.review-response-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.review-response-row-column {
  display: block;
}

.review-response-label {
  display: block;
  font-size: 26rpx;
  color: #2b313a;
}

.review-response-value {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #50555f;
  word-break: break-all;
}

.review-response-rejected {
  margin-top: 0;
  color: #d92d20;
  font-weight: 700;
}

.review-response-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #d92d20;
}

.review-response-hint {
  display: block;
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #737a87;
}

.review-return-address {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.review-return-address-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.review-return-address-picker {
  flex-shrink: 0;
  height: 54rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #1677ff;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1677ff;
  font-size: 24rpx;
  line-height: 52rpx;
}

.review-return-address-picker::after {
  border: none;
}

.review-return-address-card {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
}

.review-return-address-contact,
.review-return-address-text,
.review-return-address-empty {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
}

.review-return-address-contact {
  color: #252b35;
  font-weight: 700;
}

.review-return-address-text {
  margin-top: 6rpx;
  color: #626b78;
  word-break: break-all;
}

.review-return-address-empty {
  margin-top: 16rpx;
  color: #8a92a3;
}

.review-response-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
