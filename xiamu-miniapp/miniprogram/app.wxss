/**app.wxss**/
page {
  background: #ffffff;
}

.page {
  position: relative;
  min-height: 100vh;
  background: #ffffff;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

.page-shell {
  width: 100%;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.route-loading {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  background: #ffffff;
  color: #8a8f99;
}

.page-loading-blank {
  flex: 1;
  min-height: 0;
  background: #ffffff;
}

.route-loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid #e6e9ef;
  border-top-color: #1677ff;
  border-radius: 50%;
  box-sizing: border-box;
  animation: route-loading-spin 0.8s linear infinite;
}

.route-loading-text {
  font-size: 26rpx;
  line-height: 1.4;
}

@keyframes route-loading-spin {
  to {
    transform: rotate(360deg);
  }
}

/* Shared navigation icons use the supplied bitmap assets. */
.navigation-back-icon,
.navigation-forward-icon {
  width: 32rpx !important;
  height: 32rpx !important;
  flex-shrink: 0;
  display: block;
  border: 0 !important;
  box-sizing: border-box;
  transform: none !important;
}

.navigation-back-icon-light {
  filter: invert(1);
}
