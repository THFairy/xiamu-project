page {
  height: 100%;
  background: #ffffff;
  color: #1a1a1a;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.status-holder {
  width: 100%;
}

.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx 20rpx;
  background: #ffffff;
}

.nav-left {
  min-width: 96rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 38rpx;
  font-weight: 700;
  color: #21242b;
}

.capsule {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 12rpx 22rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
}

.capsule-dot,
.capsule-ring {
  font-size: 26rpx;
  color: #222222;
  font-weight: 700;
}

.content-scroll {
  flex: 1;
  min-height: 0;
}

.avatar-wrap {
  display: flex;
  justify-content: center;
  padding: 70rpx 0 50rpx;
  background: #ffffff;
}

.avatar-button {
  width: 188rpx;
  height: 188rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  line-height: 1;
}

.avatar-button::after {
  border: none;
}

.avatar-image {
  width: 188rpx;
  height: 188rpx;
  border-radius: 50%;
  background: #efeff2;
}

.section-card {
  margin: 0 24rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.1);
}

.field-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f1f4;
}

.field-item:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 34rpx;
  color: #2b313a;
}

.field-value-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  margin-left: 24rpx;
}

.field-value {
  max-width: 360rpx;
  text-align: right;
  font-size: 34rpx;
  color: #c3c6ce;
}

.field-value-dark {
  color: #50555f;
}

.field-arrow {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #c3c6ce;
}

.nickname-input {
  flex: 1;
  margin-left: 40rpx;
  text-align: right;
  font-size: 34rpx;
  color: #50555f;
}
