<view class="page">
  <view wx:if="{{isLoading}}" class="route-loading">
    <view class="route-loading-spinner"></view>
    <text class="route-loading-text">正在加载页面</text>
  </view>

  <block wx:elif="{{product}}">
    <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="hero-section">
        <view class="status-holder" style="height: {{statusBarHeight}}px;"></view>

        <view class="nav-bar">
          <view class="nav-left" catchtap="onBackTap">
            <view class="nav-back"></view>
          </view>
          <text class="nav-title">{{pageTitle}}</text>
          <view style="width: 144rpx; height: 56rpx; flex-shrink: 0;"></view>
        </view>

        <view class="hero-banner hero-{{product.heroTheme}}">
          <block wx:if="{{heroImages.length}}">
            <swiper
              class="hero-swiper"
              autoplay="{{hasMultipleHeroImages}}"
              circular="{{hasMultipleHeroImages}}"
              touchable="{{true}}"
              interval="3500"
              duration="400"
              indicator-dots="{{hasMultipleHeroImages}}"
              indicator-color="rgba(255,255,255,0.5)"
              indicator-active-color="#ffffff"
            >
              <block wx:for="{{heroImages}}" wx:key="index">
                <swiper-item class="hero-swiper-item">
                  <view class="hero-swiper-frame" data-index="{{index}}" bindtap="onHeroImagePreview">
                    <image class="hero-image" src="{{item}}" mode="aspectFill"></image>
                    <view class="hero-image-mask"></view>
                    <view class="hero-copy">
                      <text class="hero-copy-desc">{{product.heroAccent}}</text>
                    </view>
                  </view>
                </swiper-item>
              </block>
            </swiper>
          </block>

          <block wx:else>
            <view class="hero-glow hero-glow-a"></view>
            <view class="hero-glow hero-glow-b"></view>
            <view class="hero-card">
              <text class="hero-platform">{{product.platform}}</text>
              <text class="hero-cover">{{product.coverTitle}}</text>
              <text class="hero-accent">{{product.heroAccent}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="detail-card">
        <view class="title-block">
          <text class="product-title">{{product.title}}</text>
          <text class="product-subtitle">{{product.subtitle}}</text>
        </view>

        <view class="price-row">
          <text class="price-text">{{product.price}}元</text>
          <text wx:if="{{product.editionLabel}}" class="edition-chip">{{product.editionLabel}}</text>
        </view>

        <view class="tag-row">
          <block wx:for="{{featureTags}}" wx:key="index">
            <text class="feature-tag">{{item}}</text>
          </block>
        </view>

        <view class="meta-list">
          <block wx:for="{{detailMetas}}" wx:key="id">
            <view class="meta-item">
              <text class="meta-icon meta-icon-{{item.theme}}"></text>
              <text class="meta-text">{{item.text}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="quick-bar">
        <block wx:for="{{quickActions}}" wx:key="id">
          <view class="quick-item {{item.active ? 'quick-item-active' : ''}}" data-key="{{item.key}}" bindtap="onActionTap">
            <image class="quick-icon" src="{{item.iconPath}}" mode="aspectFit"></image>
            <text class="quick-text">{{item.text}}</text>
          </view>
        </block>
      </view>

      <view class="section-card">
        <view class="section-head">
          <text class="section-title">商品描述</text>
        </view>
        <text class="section-desc">{{productDescriptionText}}</text>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <view wx:if="{{!isSnapshot}}" class="bottom-bar">
      <view class="bottom-tools">
        <view class="tool-item">
          <view class="tool-hitbox">
            <button class="tool-contact-trigger" open-type="contact" hover-class="none"></button>
            <image class="tool-icon-image" src="/pages/images/index-images/share/客服.png" mode="aspectFit"></image>
            <text class="tool-text">客服</text>
          </view>
        </view>
        <view class="tool-item">
          <view class="tool-hitbox">
            <view class="tool-icon-wrap">
              <image class="tool-icon-image" src="/pages/images/index-images/share/分享.png" mode="aspectFit"></image>
            </view>
            <text class="tool-text">分享</text>
            <button class="tool-share-trigger" open-type="share" hover-class="none"></button>
          </view>
        </view>
      </view>

      <view class="bottom-actions">
        <button class="action-button action-button-recycle" bindtap="onRecycleTap">回收</button>
        <button class="action-button action-button-cart" bindtap="onCartTap">购物车</button>
        <button wx:if="{{product.inStock}}" class="action-button action-button-buy" bindtap="onPurchaseTap">购买</button>
        <view wx:else class="action-button action-button-buy action-button-disabled">已售罄</view>
      </view>
    </view>

    <view wx:if="{{isSnapshot}}" class="snapshot-notice">当前展示的是回收订单检测快照</view>
  </block>

  <block wx:else>
    <view class="empty-page">
      <text class="empty-title">商品已售罄或下架</text>
      <button class="empty-back" bindtap="onBackTap">返回上一页</button>
    </view>
  </block>
</view>
