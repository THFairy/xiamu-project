page {
  height: 100%;
  background: #ffffff;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.detail-scroll {
  flex: 1;
  min-height: 0;
}

.status-holder {
  width: 100%;
  background: #ffffff;
}

.hero-section {
  position: relative;
  min-height: 520rpx;
  background: #ffffff;
  color: #ffffff;
  overflow: hidden;
}

.hero-nintendo {
  background: linear-gradient(180deg, #112838 0%, #224f68 52%, #0d161d 100%);
}

.hero-sony {
  background: linear-gradient(180deg, #0f2a5c 0%, #244ca3 58%, #0f1626 100%);
}

.hero-steam {
  background: linear-gradient(180deg, #10151c 0%, #233547 52%, #111111 100%);
}

.hero-asus {
  background: linear-gradient(180deg, #1a132a 0%, #4a2b82 55%, #1b1027 100%);
}

.hero-others {
  background: linear-gradient(180deg, #2f3139 0%, #4c505d 55%, #1d1e22 100%);
}

.nav-bar {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #ffffff;
}

.nav-left {
  width: 96rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  position: relative;
  z-index: 11;
  flex-shrink: 0;
}

.nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 12rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
  pointer-events: none;
}

.nav-title {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #111111;
}

.capsule {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 144rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  box-sizing: border-box;
}

.capsule-dot,
.capsule-ring {
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
}

.hero-banner {
  position: relative;
  height: 380rpx;
  margin-top: 0;
  overflow: hidden;
  border-radius: 0;
  background: #ffffff;
}

.hero-swiper,
.hero-swiper-item,
.hero-swiper-frame {
  width: 100%;
  height: 100%;
}

.hero-swiper {
  position: relative;
  z-index: 3;
}

.hero-swiper-frame {
  position: relative;
  overflow: hidden;
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-image-mask {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgba(7, 12, 22, 0.08) 0%, rgba(7, 12, 22, 0.52) 100%);
  pointer-events: none;
}

.hero-copy {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 28rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  color: #ffffff;
  pointer-events: none;
}

.hero-copy-tag {
  align-self: flex-start;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.hero-copy-title {
  margin-top: 18rpx;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 700;
}

.hero-copy-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.88);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-glow-a {
  top: 18rpx;
  left: -40rpx;
  width: 220rpx;
  height: 220rpx;
}

.hero-glow-b {
  right: 12rpx;
  bottom: 18rpx;
  width: 180rpx;
  height: 180rpx;
}

.hero-card {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 280rpx;
  height: 300rpx;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.12);
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(8rpx);
}

.hero-platform {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.hero-cover {
  margin-top: 18rpx;
  font-size: 62rpx;
  font-weight: 700;
}

.hero-accent {
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.detail-card {
  margin-top: -28rpx;
  padding: 28rpx 26rpx 24rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.title-block {
  display: flex;
  flex-direction: column;
}

.product-title {
  font-size: 38rpx;
  line-height: 1.4;
  color: #1d2430;
  font-weight: 700;
}

.product-subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a92a3;
}

.price-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
}

.price-text {
  font-size: 54rpx;
  line-height: 1;
  color: #e62222;
  font-weight: 700;
}

.edition-chip {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #fff1dd;
  color: #c98311;
  font-size: 24rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.feature-tag {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: #f3f7ff;
  color: #3b6ec5;
  font-size: 22rpx;
}

.meta-list {
  margin-top: 28rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.meta-item + .meta-item {
  margin-top: 18rpx;
}

.meta-icon {
  width: 12rpx;
  height: 12rpx;
  margin-top: 0;
  border-radius: 50%;
  flex-shrink: 0;
}

.meta-icon-gold {
  background: #1677ff;
}

.meta-icon-blue {
  background: #5898ff;
}

.meta-icon-rose {
  background: #ff6f82;
}

.meta-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #4b5565;
}

.quick-bar {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 20rpx 26rpx;
  background: #ffffff;
  border-top: 1rpx solid #edf0f5;
  border-bottom: 1rpx solid #edf0f5;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
  transition: transform 0.16s ease;
}

.quick-item-active .quick-text {
  color: #2563eb;
  font-weight: 700;
}

.quick-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.7;
}

.quick-item-active .quick-icon {
  opacity: 1;
}

.quick-text {
  font-size: 24rpx;
  color: #434b58;
}

.section-card {
  margin-top: 18rpx;
  padding: 28rpx 26rpx;
  background: #ffffff;
}

.section-head {
  display: flex;
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  color: #202631;
  font-weight: 700;
}

.section-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #667082;
}

.bottom-space {
  height: 140rpx;
}

.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eceff4;
  box-sizing: border-box;
}

.bottom-tools {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 72rpx;
  flex-shrink: 0;
}

.tool-hitbox {
  position: relative;
  display: inline-flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.tool-icon-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
}

.tool-icon {
  font-size: 24rpx;
  line-height: 1;
  color: #222222;
  font-weight: 700;
}

.tool-icon-image {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.tool-share-trigger {
  position: absolute;
  inset: 0;
  margin: 0;
  padding: 0;
  min-width: 0;
  min-height: 0;
  line-height: 1;
  border: none;
  border-radius: 0;
  background: transparent;
}

.tool-contact-trigger {
  position: absolute;
  inset: 0;
  margin: 0;
  padding: 0;
  min-width: 0;
  min-height: 0;
  line-height: 1;
  border: none;
  border-radius: 0;
  background: transparent;
}

.tool-contact-trigger::after {
  border: none;
}

.tool-share-trigger::after {
  border: none;
}

.tool-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #505866;
}

.bottom-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.action-button {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  color: #111111;
  background: #ffffff;
  border: 2rpx solid #111111;
}

.action-button::after {
  border: none;
}

.action-button-buy {
  color: #ffffff;
  background: #1677ff;
  border-color: #1677ff;
}

.action-button-disabled {
  color: #8b93a1;
  background: #edf0f4;
  border-color: #d9dee7;
  text-align: center;
}

.snapshot-notice {
  flex-shrink: 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 24rpx;
  color: #8b93a1;
  background: #ffffff;
  box-shadow: 0 -6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.empty-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #4e5664;
}

.empty-back {
  margin: 0;
  padding: 0;
  height: auto;
  line-height: 1;
  border-radius: 0;
  background: transparent;
  color: #111111;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
}

.empty-back::after {
  border: none;
}
