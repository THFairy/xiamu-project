page {
  height: 100%;
  background: #ffffff;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.status-holder {
  width: 100%;
  background: #ffffff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #ffffff;
}

.nav-left {
  min-width: 96rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.nav-title {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  color: #111111;
}

.capsule {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 144rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx #e6e6e6;
  box-sizing: border-box;
}

.capsule-dot,
.capsule-ring {
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
  color: #111111;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.content {
  padding: 20rpx 20rpx 160rpx;
}

.address-card,
.product-card,
.amount-card,
.payment-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.address-card {
  display: flex;
  align-items: center;
}

.address-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.address-icon-image {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.address-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.address-title {
  font-size: 40rpx;
  color: #222222;
  font-weight: 600;
}

.address-title-filled {
  font-size: 30rpx;
  line-height: 1.4;
}

.address-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

.address-desc-filled {
  color: #555555;
  line-height: 1.5;
}

.address-arrow-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 40rpx;
  min-height: 40rpx;
  padding-left: 12rpx;
}

.card-arrow {
  font-size: 30rpx;
  color: #c4c4c4;
  line-height: 1;
}

.product-top {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.product-thumb {
  width: 126rpx;
  height: 126rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.product-thumb-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff3b30 0%, #b60000 100%);
}

.product-thumb-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 700;
}

.product-copy {
  flex: 1;
  min-width: 0;
}

.product-title {
  font-size: 30rpx;
  line-height: 1.5;
  color: #222222;
  font-weight: 600;
}

.product-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8f8f8f;
}

.service-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.service-tag {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: #f3f7ff;
  color: #3b6ec5;
  font-size: 22rpx;
}

.product-price-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.product-price {
  font-size: 36rpx;
  color: #202020;
  font-weight: 700;
}

.product-seller {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9b9b9b;
}

.remark-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f1f1f1;
}

.remark-label {
  font-size: 28rpx;
  color: #333333;
}

.remark-value-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.remark-value {
  max-width: 420rpx;
  font-size: 24rpx;
  color: #b0b0b0;
  text-align: right;
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.amount-row + .amount-row {
  margin-top: 22rpx;
}

.amount-label,
.amount-value,
.amount-total-label {
  font-size: 28rpx;
  color: #333333;
}

.amount-row-total {
  justify-content: flex-end;
  margin-top: 34rpx;
}

.amount-total-label {
  font-weight: 600;
}

.amount-total-value {
  font-size: 36rpx;
  color: #202020;
  font-weight: 700;
}

.payment-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.payment-copy {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.payment-label {
  font-size: 30rpx;
  color: #222222;
  font-weight: 600;
}

.payment-desc {
  font-size: 24rpx;
  color: #a5a5a5;
}

.payment-selected-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.payment-selected {
  font-size: 28rpx;
  color: #222222;
}

.payment-arrow {
  font-size: 30rpx;
  color: #c4c4c4;
  line-height: 1;
}

.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #ececec;
}

.bottom-price {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.bottom-price-value {
  font-size: 46rpx;
  color: #111111;
  font-weight: 700;
}

.submit-button {
  width: 240rpx;
  height: 82rpx;
  line-height: 82rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.submit-button::after {
  border: none;
}

.address-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.38);
  box-sizing: border-box;
}

.address-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 30rpx 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.address-modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #111111;
  text-align: center;
}

.address-modal-field,
.address-modal-input {
  width: 100%;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #f7f7f7;
  font-size: 28rpx;
  color: #222222;
  line-height: 1.6;
  box-sizing: border-box;
}

.address-modal-field {
  height: 88rpx;
  line-height: 44rpx;
}

.address-modal-input {
  min-height: 180rpx;
}

.address-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.address-modal-button {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.address-modal-button::after {
  border: none;
}

.address-modal-cancel {
  background: #f1f1f1;
  color: #666666;
}

.address-modal-confirm {
  background: #111111;
  color: #ffffff;
}

.remark-input {
  width: 420rpx;
  height: 56rpx;
  font-size: 24rpx;
  color: #333333;
  text-align: right;
}

.remark-input-placeholder {
  color: #b0b0b0;
}

.empty-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #4e5664;
}

.empty-back {
  margin: 0;
  padding: 0;
  height: auto;
  line-height: 1;
  border-radius: 0;
  background: transparent;
  color: #111111;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
}

.empty-back::after {
  border: none;
}
