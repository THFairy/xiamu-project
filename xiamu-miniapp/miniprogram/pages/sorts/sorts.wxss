page {
  height: 100%;
  background: #ffffff;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  position: relative;
  padding: 0 28rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.status-holder {
  width: 100%;
}

.header {
  padding: 20rpx 0 24rpx;
  flex-shrink: 0;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
}

.header-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9097a3;
}

.partition-scroll {
  margin: 4rpx 0 0;
  white-space: nowrap;
  flex-shrink: 0;
}

.partition-list {
  display: inline-flex;
  align-items: center;
  gap: 22rpx;
  padding-right: 20rpx;
}

.partition-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 78rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #2b313a;
  background: transparent;
  transition: all 0.2s ease;
}

.partition-item-active {
  background: #111111;
  color: #ffffff;
}

.partition-text {
  font-size: 28rpx;
  font-weight: 600;
}

.partition-progress {
  position: relative;
  height: 4rpx;
  margin: 10rpx 0 16rpx;
  border-radius: 999rpx;
  background: #eef0f4;
  overflow: hidden;
  flex-shrink: 0;
}

.partition-progress-thumb {
  position: absolute;
  top: 0;
  height: 100%;
  border-radius: 999rpx;
  background: #111111;
  transition: left 0.12s ease, width 0.12s ease;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-bottom: 18rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: #eef0f4;
  color: #a2a7b1;
  flex-shrink: 0;
}

.search-icon-image {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1f2630;
}

.search-clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  display: block;
}

.filter-wrap {
  position: relative;
  z-index: 3;
  margin-bottom: 22rpx;
  flex-shrink: 0;
}

.filter-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
  background: #ffffff;
  border-radius: 18rpx;
}

.filter-bar-sort-options {
  justify-content: stretch;
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 76rpx;
}

.filter-item-active .filter-text {
  color: #e60012;
}

.filter-option-inline {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.filter-text {
  font-size: 28rpx;
  color: #323843;
}

.filter-text.filter-text-active {
  color: #1677FF;
  font-weight: 700;
}

.filter-arrow {
  font-size: 18rpx;
  color: #848b97;
  transition: transform 0.2s ease;
}

.filter-arrow-open {
  transform: rotate(180deg);
}

.filter-dropdown-area {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 10rpx);
  z-index: 6;
}

.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 17, 17, 0.08);
}

.filter-panel {
  position: absolute;
  top: 0;
  width: 33.3333%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}

.filter-panel-model {
  left: 0;
}

.filter-panel-filter {
  left: 33.3333%;
}

.filter-panel-sort {
  right: 0;
}

.filter-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  background: #f5f6fa;
  box-sizing: border-box;
}

.filter-option-active {
  background: #fff0f0;
}

.filter-option-text {
  width: 100%;
  font-size: 26rpx;
  color: #323843;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-option-text-active {
  color: #e60012;
  font-weight: 700;
}

.product-section {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.product-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  flex-shrink: 0;
}

.product-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d232c;
}

.product-section-count {
  font-size: 24rpx;
  color: #98a0ab;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 20rpx;
}

.product-scroll {
  flex: 1;
  min-height: 0;
}

.product-card {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 22rpx;
  border: 1px solid #BEBEBE;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
}

.product-cover {
  width: 148rpx;
  min-width: 148rpx;
  height: 148rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #121212 0%, #ff4d4f 100%);
}

.product-cover-image {
  width: 100%;
  height: 100%;
  display: block;
}

.product-cover-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.product-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.product-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #1f2630;
}

.product-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff0f0;
  font-size: 22rpx;
  color: #e60012;
}

.product-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9097a3;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 18rpx;
}

.product-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #e60012;
}

.product-action {
  font-size: 24rpx;
  color: #1f2630;
}

.product-list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 8rpx 0 20rpx;
}

.product-list-end,
.product-list-prompt,
.product-list-loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #98a0ab;
}

.product-list-spinner {
  width: 22rpx;
  height: 22rpx;
  margin-right: 10rpx;
  border: 3rpx solid rgba(152, 160, 171, 0.25);
  border-top-color: #98a0ab;
  border-radius: 50%;
  box-sizing: border-box;
  animation: product-list-spinner-rotate 0.75s linear infinite;
}

.product-list-loading-text {
  display: inline-block;
}

@keyframes product-list-spinner-rotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.product-empty-state {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #ffffff;
}

.product-empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2630;
}

.product-empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #98a0ab;
}

.tab-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 0 env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -6rpx 16rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  color: #7f8591;
}

.tab-item-active {
  color: #1677ff;
}

.tab-icon-image {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.tab-text {
  margin-top: 10rpx;
  font-size: 26rpx;
}
