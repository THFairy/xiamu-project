<!-- 订单页面结构与审核结果展示 -->
<view class="page">
  <view wx:if="{{isTabLoading}}" class="route-loading">
    <view class="route-loading-spinner"></view>
    <text class="route-loading-text">正在加载页面</text>
  </view>

  <view wx:else class="page-shell {{pageTransitionClass}}">
    <view class="content">
      <view class="status-holder" style="height: {{statusBarHeight}}px;"></view>

      <view class="top-bar">
        <text class="top-bar-title">{{pageTitle}}</text>
        <view style="width: 148rpx; height: 56rpx; flex-shrink: 0;"></view>
      </view>

      <view class="order-mode-list">
        <block wx:for="{{orderModes}}" wx:key="id">
          <view class="order-mode-item {{item.active ? 'order-mode-item-active' : ''}}" data-key="{{item.key}}" bindtap="onOrderModeTap">
            <text class="order-mode-text">{{item.text}}</text>
          </view>
        </block>
      </view>

      <block wx:if="{{currentMode === 'buy' && buyItems.length}}">
        <scroll-view class="cart-list" scroll-y enhanced show-scrollbar="{{false}}">
          <block wx:for="{{buyItems}}" wx:key="id">
            <view class="cart-item {{fromMineEntry ? 'cart-item-link' : ''}}">
              <view
                class="cart-select-button {{item.selected ? 'cart-select-button-active' : ''}}"
                data-order-id="{{item.id}}"
                catchtap="onBuySelectTap"
              >
                <view class="cart-select-dot"></view>
              </view>
              <image
                wx:if="{{item.product.heroImage}}"
                class="cart-cover cart-cover-image"
                src="{{item.product.heroImage}}"
                mode="aspectFill"
              ></image>
              <view wx:else class="cart-cover">{{item.product.coverTitle}}</view>
              <view class="cart-copy">
                <view class="cart-copy-hitbox" data-product-id="{{item.product.id}}" data-order-id="{{item.id}}" bindtap="onBuyItemTap">
                  <text class="cart-title">{{item.product.title}}</text>
                  <text class="cart-subtitle">{{item.product.subtitle}}</text>
                  <text wx:if="{{fromMineEntry}}" class="cart-meta">{{item.product.platform}}</text>
                  <text wx:else class="cart-tag cart-tag-buy">{{item.statusText}}</text>
                </view>
              </view>
              <view class="cart-price-wrap {{fromMineEntry ? 'cart-price-wrap-link' : ''}}">
                <text class="cart-price">{{item.totalAmountText}}</text>
                <text class="cart-platform {{fromMineEntry ? 'cart-platform-success' : ''}}">
                  {{fromMineEntry ? item.statusText : item.product.platform}}
                </text>
              </view>
              <image wx:if="{{fromMineEntry && false}}" class="cart-link-arrow navigation-forward-icon" src="/pages/images/index-images/前往.png" mode="aspectFit"></image>
              <view wx:if="{{fromMineEntry}}" class="buy-action-group">
                <view
                  class="buy-confirm-button {{item.canConfirmReceipt ? '' : 'buy-confirm-button-disabled'}}"
                  data-order-id="{{item.id}}"
                  catchtap="onBuyConfirmReceiptTap"
                >确认收货</view>
                <view class="buy-delete-button" data-order-id="{{item.id}}" catchtap="onBuyDeleteTap">
                  <image class="buy-delete-icon" src="/pages/images/order-images/delete.jpg" mode="aspectFit"></image>
                </view>
              </view>
              <view wx:if="{{!fromMineEntry}}" class="pending-order-action-group">
                <text class="pending-order-countdown">{{item.countdownText}}</text>
                <view class="recycle-delete-button" data-order-id="{{item.id}}" catchtap="onBuyDeleteTap">
                  <image class="recycle-delete-icon" src="/pages/images/order-images/delete.jpg" mode="aspectFit"></image>
                </view>
              </view>
            </view>
          </block>
        </scroll-view>
      </block>

      <block wx:elif="{{currentMode === 'cart' && cartItems.length}}">
        <scroll-view class="cart-list" scroll-y enhanced show-scrollbar="{{false}}">
          <block wx:for="{{cartItems}}" wx:key="addedAt">
            <view class="cart-item">
              <view
                wx:if="{{!fromMineEntry}}"
                class="cart-select-button {{item.selected ? 'cart-select-button-active' : ''}}"
                data-added-at="{{item.addedAt}}"
                catchtap="onCartSelectTap"
              >
                <view class="cart-select-dot"></view>
              </view>
              <image
                wx:if="{{item.product.heroImage}}"
                class="cart-cover cart-cover-image"
                src="{{item.product.heroImage}}"
                mode="aspectFill"
              ></image>
              <view wx:else class="cart-cover">{{item.product.coverTitle}}</view>
              <view class="cart-copy">
                <view class="cart-copy-hitbox" data-product-id="{{item.product.id}}" bindtap="onCartItemTap">
                  <text class="cart-title">{{item.product.title}}</text>
                  <text class="cart-subtitle">{{item.product.subtitle}}</text>
                </view>
              </view>
              <view class="cart-price-wrap">
                <text class="cart-price">{{item.product.price}}元</text>
                <text class="cart-platform">{{item.product.platform}}</text>
              </view>
              <view class="recycle-delete-button" data-added-at="{{item.addedAt}}" catchtap="onCartDeleteTap">
                <image class="recycle-delete-icon" src="/pages/images/order-images/delete.jpg" mode="aspectFit"></image>
              </view>
            </view>
          </block>
        </scroll-view>
      </block>

      <block wx:elif="{{currentMode !== 'buy' && currentMode !== 'cart' && displayedRecycleItems.length}}">
        <scroll-view class="cart-list" scroll-y enhanced show-scrollbar="{{false}}">
          <block wx:for="{{displayedRecycleItems}}" wx:key="id">
            <view class="cart-item recycle-item {{fromMineEntry ? 'cart-item-link' : ''}} {{fromMineEntry && currentMode === 'settlement' ? 'cart-item-settlement' : ''}}">
              <view
                wx:if="{{!fromMineEntry && currentMode !== 'settlement' && item.source === 'local'}}"
                class="cart-select-button {{item.selected ? 'cart-select-button-active' : ''}}"
                data-order-id="{{item.id}}"
                data-source="{{item.source}}"
                catchtap="onRecycleSelectTap"
              >
                <view class="cart-select-dot"></view>
              </view>
              <image
                wx:if="{{item.coverImage}}"
                class="cart-cover cart-cover-image recycle-cover-image"
                src="{{item.coverImage}}"
                mode="aspectFill"
                data-published-product-id="{{item.publishedProductId}}"
                data-order-id="{{item.id}}"
                data-source="{{item.source}}"
                bindtap="onRecycleItemTap"
              ></image>
              <view
                wx:else
                class="cart-cover recycle-cover recycle-cover-{{item.coverTheme}}"
                data-published-product-id="{{item.publishedProductId}}"
                data-order-id="{{item.id}}"
                data-source="{{item.source}}"
                bindtap="onRecycleItemTap"
              >{{item.coverLabel}}</view>
              <view class="cart-copy">
                <view
                  class="cart-copy-hitbox"
                  data-published-product-id="{{item.publishedProductId}}"
                  data-order-id="{{item.id}}"
                  data-source="{{item.source}}"
                  bindtap="onRecycleItemTap"
                >
                  <text class="cart-title">{{item.title}}</text>
                  <text class="cart-subtitle">{{currentMode === 'settlement' ? item.settlementStatusText : item.optionSummary}}</text>
                  <text wx:if="{{fromMineEntry}}" class="cart-meta">{{item.payoutMethodLabel}} {{item.realName}}</text>
                  <text wx:else class="cart-tag cart-tag-recycle">收款人：{{item.realName}}</text>
                </view>
              </view>
              <view class="cart-price-wrap {{fromMineEntry ? 'cart-price-wrap-link' : ''}}">
                <text wx:if="{{fromMineEntry || currentMode === 'settlement'}}" class="cart-price">{{item.finalPriceText}}</text>
                <text wx:else class="recycle-status">{{item.payoutMethodLabel}}</text>
                <text wx:if="{{!(fromMineEntry && currentMode === 'recycle' && item.paymentProofImages.length)}}" class="cart-platform {{fromMineEntry ? 'cart-platform-success' : ''}}">
                  {{currentMode === 'settlement' ? item.settlementStatusText : (fromMineEntry ? item.singleViewStatusText : item.statusText)}}
                </text>
                <view
                  wx:if="{{fromMineEntry && currentMode === 'recycle' && item.paymentProofImages.length}}"
                  class="settlement-proof-button settlement-proof-button-inline"
                  data-order-id="{{item.id}}"
                  catchtap="onPaymentProofTap"
                >查看打款证明</view>
              </view>
              <view wx:if="{{fromMineEntry && currentMode === 'settlement' && item.settlementClaimButtonVisible}}" class="settlement-action-group">
                <view
                  class="settlement-claim-button {{item.settlementCanClaim ? '' : 'settlement-claim-button-disabled'}}"
                  data-order-id="{{item.id}}"
                  catchtap="onRecycleClaimTap"
                >{{item.settlementCanClaim ? '领取' : item.settlementStatusText}}</view>
              </view>
              <view
                wx:if="{{fromMineEntry && currentMode === 'settlement' && item.paymentProofImages.length}}"
                class="settlement-proof-button"
                data-order-id="{{item.id}}"
                catchtap="onPaymentProofTap"
              >查看打款证明</view>
              <view
                wx:if="{{!fromMineEntry && currentMode !== 'settlement' && item.source === 'server' && item.isSfPickup && !item.sfPickupCanceled}}"
                class="recycle-cancel-button"
                data-order-id="{{item.id}}"
                catchtap="onRecycleCancelActionTap"
              >
                <image
                  class="recycle-cancel-icon"
                  src="/pages/images/order-images/cancel-order.jpg"
                  mode="aspectFit"
                  data-order-id="{{item.id}}"
                  catchtap="onRecycleCancelActionTap"
                ></image>
              </view>
              <view class="recycle-delete-button" data-order-id="{{item.id}}" data-source="{{item.source}}" catchtap="onRecycleDeleteActionTap">
                <image
                  class="recycle-delete-icon"
                  src="/pages/images/order-images/delete.jpg"
                  mode="aspectFit"
                  data-order-id="{{item.id}}"
                  data-source="{{item.source}}"
                  catchtap="onRecycleDeleteActionTap"
                ></image>
              </view>
            </view>
          </block>
        </scroll-view>
      </block>

      <block wx:else>
        <view class="empty-area">
          <view class="empty-card">
            <image class="empty-order-image" src="/pages/images/order-images/暂无订单.jpg" mode="aspectFit"></image>
            <text class="empty-text">该页暂无订单</text>
          </view>
        </view>
      </block>

      <view wx:if="{{currentMode === 'buy' && !fromMineEntry && itemCount === 0}}" class="mode-notice">
        <text class="mode-notice-text">请及时进行商品付款，超时会自动取消您的订单！</text>
      </view>

      <view wx:if="{{itemCount > 0}}" class="summary-row {{fromMineEntry ? 'summary-row-subpage' : ''}}">
        <text class="summary-count">已选{{itemCount}}件</text>
        <view class="summary-actions">
          <button wx:if="{{!fromMineEntry && currentMode !== 'settlement'}}" class="summary-action-button checkout-button" bindtap="onCheckoutTap">{{primaryActionText}}</button>
          <button class="summary-action-button clear-button" bindtap="onClearTap">{{secondaryActionText}}</button>
        </view>
      </view>
    </view>

    <view wx:if="{{purchaseDetailVisible}}" class="pickup-detail-mask" bindtap="closePurchaseDetail">
      <view class="pickup-detail-modal purchase-detail-modal" catchtap="stopPickupDetailTap">
        <view class="pickup-detail-head">
          <text class="pickup-detail-title">已购买订单</text>
          <text class="pickup-detail-close" bindtap="closePurchaseDetail">关闭</text>
        </view>

        <view class="purchase-detail-product">
          <image wx:if="{{purchaseDetailOrder.product.heroImage}}" class="purchase-detail-cover" src="{{purchaseDetailOrder.product.heroImage}}" mode="aspectFill"></image>
          <view wx:else class="purchase-detail-cover purchase-detail-cover-empty">{{purchaseDetailOrder.product.coverTitle}}</view>
          <text class="purchase-detail-product-name">{{purchaseDetailOrder.product.title}}</text>
        </view>

        <view class="pickup-detail-row">
          <text class="pickup-detail-label">订单编号</text>
          <text class="pickup-detail-value">{{purchaseDetailOrder.orderNo || '暂无'}}</text>
        </view>
        <view class="pickup-detail-row">
          <text class="pickup-detail-label">商户单号</text>
          <text class="pickup-detail-value">{{purchaseDetailOrder.merchantOrderNo || '暂无'}}</text>
        </view>
        <view class="pickup-detail-row">
          <text class="pickup-detail-label">下单时间</text>
          <text class="pickup-detail-value">{{purchaseDetailOrder.createdAtText || '暂无'}}</text>
        </view>
        <view class="pickup-detail-row">
          <text class="pickup-detail-label">实付金额</text>
          <text class="pickup-detail-value purchase-detail-price">{{purchaseDetailOrder.totalAmountText}}</text>
        </view>
        <view class="pickup-detail-row">
          <text class="pickup-detail-label">支付状态</text>
          <text class="pickup-detail-value">{{purchaseDetailOrder.statusText}}</text>
        </view>
        <view class="pickup-detail-row">
          <text class="pickup-detail-label">收货人</text>
          <text class="pickup-detail-value">{{purchaseDetailOrder.recipientName || '暂无'}}</text>
        </view>
        <view class="pickup-detail-row">
          <text class="pickup-detail-label">电话</text>
          <text class="pickup-detail-value">{{purchaseDetailOrder.recipientPhone || '暂无'}}</text>
        </view>
        <view class="pickup-detail-row pickup-detail-row-column">
          <text class="pickup-detail-label">收货地址</text>
          <text class="pickup-detail-value purchase-detail-address">{{purchaseDetailOrder.addressDetail || '暂无'}}</text>
        </view>
        <view class="pickup-detail-row">
          <text class="pickup-detail-label">快递公司</text>
          <text class="pickup-detail-value">{{purchaseDetailOrder.shipData.expressCompany || '暂无发货信息'}}</text>
        </view>
        <view class="pickup-detail-row pickup-detail-row-last">
          <text class="pickup-detail-label">快递单号</text>
          <view class="pickup-detail-value-wrap">
            <text class="pickup-detail-value">{{purchaseDetailOrder.shipData.expressNo || '暂无'}}</text>
            <text wx:if="{{purchaseDetailOrder.shipData.expressNo}}" class="pickup-detail-copy" data-value="{{purchaseDetailOrder.shipData.expressNo}}" data-label="快递单号" bindtap="onPickupDetailCopyTap">复制</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{pickupDetailVisible}}" class="pickup-detail-mask" bindtap="closePickupDetail">
      <view class="pickup-detail-modal" catchtap="stopPickupDetailTap">
        <view class="pickup-detail-head">
          <text class="pickup-detail-title">顺丰上门取件</text>
          <text class="pickup-detail-close" bindtap="closePickupDetail">关闭</text>
        </view>

        <text class="pickup-detail-product">{{pickupDetailTitle}}</text>
        <text class="pickup-detail-status">{{pickupDetailStatusText}}</text>

        <view class="pickup-detail-row">
          <text class="pickup-detail-label">丰桥订单号</text>
          <view class="pickup-detail-value-wrap">
            <text class="pickup-detail-value">{{pickupDetailOrderId || '暂无'}}</text>
            <text class="pickup-detail-copy" data-value="{{pickupDetailOrderId}}" data-label="订单号" bindtap="onPickupDetailCopyTap">复制</text>
          </view>
        </view>

        <view class="pickup-detail-row">
          <text class="pickup-detail-label">顺丰运单号</text>
          <view class="pickup-detail-value-wrap">
            <text class="pickup-detail-value">{{pickupDetailWaybillNo || '暂无'}}</text>
            <text class="pickup-detail-copy" data-value="{{pickupDetailWaybillNo}}" data-label="运单号" bindtap="onPickupDetailCopyTap">复制</text>
          </view>
        </view>

        <view class="pickup-detail-row">
          <text class="pickup-detail-label">上门时间</text>
          <text class="pickup-detail-value">{{pickupDetailPickupTimeText || '暂无'}}</text>
        </view>

        <view class="pickup-detail-row">
          <text class="pickup-detail-label">姓名</text>
          <text class="pickup-detail-value">{{pickupDetailRecipientName || '暂无'}}</text>
        </view>

        <view class="pickup-detail-row">
          <text class="pickup-detail-label">电话</text>
          <view class="pickup-detail-value-wrap">
            <text class="pickup-detail-value">{{pickupDetailRecipientPhone || '暂无'}}</text>
            <text class="pickup-detail-copy" data-value="{{pickupDetailRecipientPhone}}" data-label="电话" bindtap="onPickupDetailCopyTap">复制</text>
          </view>
        </view>

        <view class="pickup-detail-row pickup-detail-row-last">
          <text class="pickup-detail-label">地址</text>
          <view class="pickup-detail-value-wrap pickup-detail-value-wrap-multiline">
            <text class="pickup-detail-value pickup-detail-value-multiline">{{pickupDetailAddressText || '暂无'}}</text>
            <text class="pickup-detail-copy" data-value="{{pickupDetailAddressText}}" data-label="地址" bindtap="onPickupDetailCopyTap">复制</text>
          </view>
        </view>

      </view>
    </view>

    <view wx:if="{{reviewResponseVisible}}" class="pickup-detail-mask" bindtap="closeReviewResponse">
      <view class="pickup-detail-modal review-response-modal" catchtap="stopPickupDetailTap">
        <view class="pickup-detail-head">
          <text class="pickup-detail-title">订单审核结果</text>
          <text class="pickup-detail-close" bindtap="closeReviewResponse">关闭</text>
        </view>

        <text class="pickup-detail-product">{{reviewResponseTitle}}</text>
        <view class="review-response-row">
          <text class="review-response-label">审核状态</text>
          <text class="review-response-value review-response-rejected">未通过</text>
        </view>
        <view class="review-response-row review-response-row-column">
          <text class="review-response-label">打回原因</text>
          <text class="review-response-value">{{reviewResponseReason}}</text>
        </view>
        <view class="review-response-row">
          <text class="review-response-label">最终报价</text>
          <text class="review-response-price">{{reviewResponseFinalPriceText}}</text>
        </view>
        <text class="review-response-hint">请确认最终报价，或选择拿回产品。</text>
        <view class="review-response-actions">
          <button class="review-response-button review-response-button-accept" data-order-id="{{reviewResponseOrderId}}" catchtap="onRecycleReviewAcceptTap">接受</button>
          <button class="review-response-button review-response-button-take-back" data-order-id="{{reviewResponseOrderId}}" catchtap="onRecycleReviewTakeBackTap">拿回</button>
        </view>
      </view>
    </view>
  </view>
  <view class="tab-bar">
    <block wx:for="{{tabs}}" wx:key="key">
      <view class="tab-item {{currentTab === item.key ? 'tab-item-active' : ''}}" data-key="{{item.key}}" data-path="{{item.path}}" bindtap="onTabTap">
        <image class="tab-icon-image" src="{{currentTab === item.key ? '/pages/images/index-images/页面切换图标/回到' + item.text + '.png' : '/pages/images/index-images/页面切换图标/' + item.text + '.png'}}" mode="aspectFit"></image>
        <text class="tab-text">{{item.text}}</text>
      </view>
    </block>
  </view>
</view>
