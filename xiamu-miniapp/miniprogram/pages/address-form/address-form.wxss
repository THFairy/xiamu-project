page {
  height: 100%;
  background: #ffffff;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.status-holder {
  width: 100%;
  background: #ffffff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #ffffff;
}

.nav-left {
  min-width: 96rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.nav-title {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  color: #111111;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.content {
  padding: 20rpx 20rpx 160rpx;
}

.saved-card,
.intro-card,
.form-card {
  border-radius: 24rpx;
  background: #ffffff;
}

.saved-card,
.intro-card {
  padding: 28rpx 24rpx;
}

.intro-card,
.form-card {
  margin-top: 20rpx;
}

.section-header,
.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title,
.intro-title,
.form-header-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #111111;
}

.section-action {
  flex-shrink: 0;
  color: #1677ff;
  font-size: 30rpx;
  font-weight: 700;
}

.saved-item {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  border: 2rpx solid #f1f1f1;
  background: #ffffff;
}

.saved-item-default {
  background: rgba(22, 119, 255, 0.06);
}

.saved-item-plain {
  background: #ffffff;
}

.saved-item-active {
  border-color: #1677ff;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.14);
}

.saved-item-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.saved-item-body {
  flex: 1;
  min-width: 0;
}

.saved-picker-indicator {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  border: 4rpx solid #1677ff;
  border-radius: 50%;
  box-sizing: border-box;
  background: #ffffff;
}

.saved-picker-indicator-active {
  background: radial-gradient(circle at center, #1677ff 0, #1677ff 44%, transparent 48%, transparent 100%);
}

.saved-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.saved-summary {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.saved-name {
  font-size: 28rpx;
  color: #202020;
  font-weight: 700;
}

.saved-phone {
  font-size: 28rpx;
  color: #6d7485;
}

.saved-default {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.saved-address {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #404659;
}

.saved-actions {
  margin-top: 22rpx;
  display: flex;
  justify-content: flex-end;
  gap: 26rpx;
}

.saved-action-default {
  color: #1677ff;
  font-size: 28rpx;
}

.saved-action-edit {
  color: #6b7280;
  font-size: 28rpx;
}

.saved-action-delete {
  color: #d94b4b;
  font-size: 28rpx;
}

.saved-empty {
  margin-top: 22rpx;
  padding: 28rpx 24rpx;
  border-radius: 22rpx;
  background: #fafafa;
}

.saved-empty-text,
.intro-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8f8f8f;
}

.intro-desc {
  margin-top: 16rpx;
}

.intro-hint {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f7f9ff;
  color: #4b6cb7;
  font-size: 22rpx;
  line-height: 1.4;
}

.form-card {
  padding: 0 24rpx;
}

.form-header {
  padding: 28rpx 0 8rpx;
}

.form-group {
  padding: 26rpx 0 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-group-last {
  border-bottom: none;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 28rpx;
  color: #202020;
}

.required-mark {
  color: #df3e3e;
  font-size: 30rpx;
  line-height: 1;
}

.form-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9aa3b2;
}

.form-input,
.form-textarea {
  width: 100%;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #f5f7fc;
  font-size: 28rpx;
  color: #222222;
  box-sizing: border-box;
}

.region-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 92rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f5f7fc;
  color: #222222;
  font-size: 28rpx;
  box-sizing: border-box;
}

.region-picker-placeholder {
  color: #b7bfcc;
}

.region-picker-arrow {
  flex-shrink: 0;
  color: #9aa3b2;
  font-size: 30rpx;
}

.location-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 92rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f5f7fc;
  box-sizing: border-box;
}

.location-picker-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #4a5260;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-map {
  width: 100%;
  height: 280rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
}

.form-input {
  height: 92rpx;
  line-height: 48rpx;
}

.form-textarea {
  min-height: 190rpx;
  line-height: 1.7;
}

.form-placeholder {
  color: #b7bfcc;
}

.bottom-bar {
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #ececec;
}

.submit-button {
  width: 420rpx;
  height: 82rpx;
  line-height: 82rpx;
  margin: 0 auto;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.submit-button-disabled {
  background: #111111;
  color: #ffffff;
  opacity: 0.45;
}

.submit-button::after {
  border: none;
}
