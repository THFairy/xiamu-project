<view class="page">
  <view class="status-holder" style="height: {{statusBarHeight}}px;"></view>

  <view class="nav-bar">
    <view class="nav-left" bindtap="onBackTap">
      <image class="nav-back navigation-back-icon" src="/pages/images/index-images/返回.png" mode="aspectFit"></image>
    </view>
    <text class="nav-title">{{pageTitle}}</text>
    <view style="width: 144rpx; height: 56rpx; flex-shrink: 0;"></view>
  </view>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollTargetId}}">
    <view class="content">
      <view class="saved-card">
        <view class="section-header">
          <text class="section-title">{{savedSectionTitle}}</text>
          <text class="section-action" bindtap="onAddTap">{{addActionText}}</text>
        </view>

        <block wx:if="{{savedAddresses.length}}">
          <block wx:for="{{savedAddresses}}" wx:key="id">
            <view class="saved-item {{item.isDefault ? 'saved-item-default' : 'saved-item-plain'}} {{(showInlineForm && item.id === editingAddressId) || (showPickerSelector && item.id === selectedAddressId) ? 'saved-item-active' : ''}}" data-address-id="{{item.id}}" bindtap="onSavedAddressTap">
              <view class="saved-item-row">
                <view wx:if="{{showPickerSelector}}" class="saved-picker-indicator {{item.id === selectedAddressId ? 'saved-picker-indicator-active' : ''}}"></view>

                <view class="saved-item-body">
                  <view class="saved-item-top">
                    <view class="saved-summary">
                      <text class="saved-name">{{item.recipientName}}</text>
                      <text class="saved-phone">{{item.recipientPhone}}</text>
                      <text wx:if="{{item.isDefault}}" class="saved-default">默认</text>
                    </view>
                  </view>
                  <text class="saved-address">{{item.fullAddressText}}</text>
                  <view class="saved-actions">
                    <text wx:if="{{!item.isDefault}}" class="saved-action-default" data-address-id="{{item.id}}" catchtap="onSetDefaultTap">设为默认</text>
                    <text class="saved-action-edit" data-address-id="{{item.id}}" catchtap="onEditTap">编辑</text>
                    <text class="saved-action-delete" data-address-id="{{item.id}}" catchtap="onDeleteTap">删除</text>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </block>

        <view wx:else class="saved-empty">
          <text class="saved-empty-text">{{emptySavedText}}</text>
        </view>
      </view>

      <view wx:if="{{showInlineForm}}" class="intro-card">
        <text class="intro-title">{{introTitle}}</text>
        <text class="intro-desc">{{introDesc}}</text>
        <text class="intro-hint">{{formHint}}</text>
      </view>

      <view wx:if="{{showInlineForm}}" id="address-form-panel" class="form-card">
        <view class="form-header">
          <text class="form-header-title">{{formModeText}}</text>
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <view class="form-label"><text class="required-mark">*</text><text>收件人姓名</text></view>
            <text class="form-count">{{nameCountText}}</text>
          </view>
          <input
            class="form-input"
            value="{{recipientName}}"
            placeholder="请输入收件人姓名"
            placeholder-class="form-placeholder"
            maxlength="20"
            cursor-spacing="24"
            bindinput="onRecipientNameInput"
          />
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <view class="form-label"><text class="required-mark">*</text><text>手机号</text></view>
            <text class="form-count">11位中国大陆手机号</text>
          </view>
          <input
            class="form-input"
            value="{{recipientPhone}}"
            placeholder="请输入手机号"
            placeholder-class="form-placeholder"
            maxlength="11"
            type="number"
            cursor-spacing="24"
            bindinput="onRecipientPhoneInput"
          />
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <view class="form-label"><text class="required-mark">*</text><text>省、市、区</text></view>
            <text class="form-count">顺丰上门取件必填</text>
          </view>
          <picker mode="region" value="{{regionValue}}" bindchange="onRegionChange">
            <view class="region-picker {{regionText ? '' : 'region-picker-placeholder'}}">
              <text>{{regionText || '请选择省、市、区'}}</text>
              <text class="region-picker-arrow">></text>
            </view>
          </picker>
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">地图位置</text>
            <text class="form-count">选点后自动回填地址</text>
          </view>
          <view class="location-picker" bindtap="onChooseLocation">
            <text class="location-picker-text">{{hasLocation ? locationTitle : '在地图中选择收货位置'}}</text>
            <image class="navigation-forward-icon" src="/pages/images/index-images/前往.png" mode="aspectFit"></image>
          </view>
          <map
            wx:if="{{hasLocation}}"
            class="location-map"
            latitude="{{latitude}}"
            longitude="{{longitude}}"
            scale="16"
            markers="{{locationMarkers}}"
            show-location="{{false}}"
          ></map>
        </view>

        <view class="form-group form-group-last">
          <view class="form-label-row">
            <view class="form-label"><text class="required-mark">*</text><text>详细地址</text></view>
            <text class="form-count">{{addressCountText}}</text>
          </view>
          <textarea
            class="form-textarea"
            value="{{addressDetail}}"
            placeholder="请输入详细收货地址，如楼栋、单元、门牌号"
            placeholder-class="form-placeholder"
            maxlength="120"
            auto-height
            cursor-spacing="24"
            bindinput="onAddressDetailInput"
          ></textarea>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{showInlineForm}}" class="bottom-bar">
    <button
      class="submit-button {{canSubmit ? '' : 'submit-button-disabled'}}"
      bindtap="onSubmitTap"
      disabled="{{!canSubmit}}"
    >{{submitButtonText}}</button>
  </view>
</view>
