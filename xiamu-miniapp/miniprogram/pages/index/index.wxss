page {
  height: 100%;
  background: #ffffff;
  color: #111111;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.hero {
  padding: 0 24rpx 12rpx;
  background: #ffffff;
}

.status-holder {
  width: 100%;
}

.top-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 0 20rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-logo {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: block;
  overflow: hidden;
  background: #ffffff;
}

.brand-copy {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.brand-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #eef0f4;
  color: #a2a7b1;
}

.search-icon-image {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #21242b;
}

.search-clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  display: block;
}

.banner-swiper {
  height: 380rpx;
  margin-top: 20rpx;
}

.banner-card {
  position: relative;
  height: 100%;
  border-radius: 26rpx;
  overflow: hidden;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.banner-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.banner-0 {
  background: linear-gradient(135deg, #141414 0%, #ff2424 48%, #ff5a00 100%);
}

.banner-1 {
  background: linear-gradient(135deg, #101828 0%, #1447ff 50%, #22b8ff 100%);
}

.banner-2 {
  background: linear-gradient(135deg, #28150d 0%, #8c1aff 45%, #ff2d78 100%);
}

.banner-copy {
  position: relative;
  z-index: 2;
  width: 62%;
  display: flex;
  flex-direction: column;
}

.banner-image + .banner-copy {
  width: 70%;
}

.banner-title {
  font-size: 58rpx;
  line-height: 1.1;
  font-weight: 700;
}

.banner-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.88);
}

.banner-decor {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 40%;
}

.decor-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.decor-a {
  right: 40rpx;
  top: 56rpx;
  width: 140rpx;
  height: 140rpx;
}

.decor-b {
  right: -20rpx;
  bottom: 20rpx;
  width: 240rpx;
  height: 240rpx;
}

.banner-word {
  position: absolute;
  right: 48rpx;
  bottom: 44rpx;
  font-size: 168rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.18);
  font-weight: 700;
}

.section {
  padding: 22rpx 24rpx 0;
}

.home-section-panel {
  margin: 22rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(31, 40, 54, 0.1);
  box-sizing: border-box;
}

.home-recommendation-panel {
  margin-top: 25rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.section-bar {
  width: 8rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #f2c300;
}

.section-dot {
  width: 34rpx;
  height: 34rpx;
  display: block;
  flex-shrink: 0;
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
}

.search-section {
  padding-bottom: 24rpx;
}

.search-head {
  justify-content: space-between;
  gap: 18rpx;
}

.search-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #8a8f99;
}

.category-grid {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  justify-content: start;
  gap: 24rpx 16rpx;
  box-sizing: border-box;
}

.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 176rpx;
  padding: 8rpx 0;
  border: none;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
  color: #111111;
  box-shadow: none;
}

.category-card-centered {
  align-items: center;
  justify-content: center;
}

.category-main {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.category-main-centered {
  align-items: center;
  justify-content: center;
  text-align: center;
}

.category-name {
  margin-top: 12rpx;
  max-width: 100%;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-count {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.category-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.category-cover {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.category-cover-centered {
  margin-left: 0;
  align-items: center;
  justify-content: center;
}

.cover-chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
}

.cover-box {
  width: 104rpx;
  height: 104rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.24);
  transform: rotate(-8deg);
}

.category-cover-image {
  width: 104rpx;
  height: 104rpx;
  border-radius: 12rpx;
  display: block;
  background: #b6bcc3;
}

.category-red {
  background: #ffffff;
  color: #111111;
}

.category-blue {
  background: #ffffff;
  color: #111111;
}

.category-yellow {
  background: #ffffff;
  color: #111111;
}

.category-yellow .category-desc {
  color: #6b7280;
}

.category-yellow .cover-chip {
  background: rgba(0, 0, 0, 0.1);
}

.category-yellow .cover-box {
  background: #b6bcc3;
}

.hot-product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.hot-product-item {
  display: flex;
  flex-direction: column;
  min-width: 0;
  border: 1px solid #BEBEBE;
  border-radius: 22rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(17, 17, 17, 0.06);
}

.hot-product-cover {
  position: relative;
  width: 100%;
  padding-top: 75%;
  overflow: hidden;
  background: #f3f4f7;
}

.hot-product-cover-image,
.hot-product-cover-fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hot-product-cover-image {
  display: block;
}

.hot-product-cover-fallback {
  padding: 16rpx;
  box-sizing: border-box;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.16);
}

.platform-NS2,
.platform-NS {
  background: linear-gradient(180deg, #ff2036 0%, #b80014 100%);
}

.platform-PS5,
.platform-PS4 {
  background: linear-gradient(180deg, #195ed1 0%, #0e2f6e 100%);
}

.platform-label {
  align-self: flex-start;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 18rpx;
}

.cover-title {
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 700;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.hot-product-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx 16rpx 16rpx;
}

.hot-product-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 72rpx;
  font-size: 28rpx;
  line-height: 1.3;
  color: #1f2329;
  font-weight: 700;
}

.hot-product-subtitle {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 22rpx;
  color: #8b909b;
  line-height: 1.45;
}

.hot-product-bottom {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 2rpx;
}

.product-list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.product-item {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.product-item:last-child {
  border-bottom: none;
}

.product-cover {
  flex-shrink: 0;
  width: 118rpx;
  height: 164rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f3f4f7;
}

.product-cover-image,
.product-cover-fallback {
  width: 100%;
  height: 100%;
}

.product-cover-image {
  display: block;
}

.product-cover-fallback {
  padding: 12rpx;
  box-sizing: border-box;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.18);
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.product-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.product-title {
  flex: 1;
  font-size: 34rpx;
  line-height: 1.35;
  color: #21242b;
}

.product-score {
  flex-shrink: 0;
  padding-left: 16rpx;
  font-size: 24rpx;
  color: #a58a29;
}

.product-subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #9298a3;
  line-height: 1.45;
}

.product-bottom {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.product-price {
  font-size: 44rpx;
  line-height: 1;
  color: #e31c1c;
  font-weight: 700;
}

.product-tag {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: #eef6ff;
  color: #5b8fd9;
  font-size: 22rpx;
}

.home-recommendation-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  padding: 0;
  box-sizing: border-box;
}

.product-list-end,
.product-list-prompt,
.product-list-loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #98a0ab;
}

.product-list-spinner {
  width: 22rpx;
  height: 22rpx;
  margin-right: 10rpx;
  border: 3rpx solid rgba(152, 160, 171, 0.25);
  border-top-color: #98a0ab;
  border-radius: 50%;
  box-sizing: border-box;
  animation: product-list-spinner-rotate 0.75s linear infinite;
}

.product-list-loading-text {
  display: inline-block;
}

@keyframes product-list-spinner-rotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.search-empty {
  display: flex;
  min-height: 280rpx;
  padding: 48rpx 36rpx;
  border-radius: 24rpx;
  background: #ffffff;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
}

.search-empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2630;
}

.search-empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #98a0ab;
}

.tab-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 0 env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  color: #7f8591;
}

.tab-item-active {
  color: #1677ff;
}

.tab-icon-image {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.tab-text {
  margin-top: 10rpx;
  font-size: 26rpx;
}
