page {
  height: 100%;
  background: #ffffff;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.fixed-header {
  flex-shrink: 0;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-holder {
  width: 100%;
  background: #ffffff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx 20rpx;
  background: #ffffff;
}

.nav-left {
  min-width: 96rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.nav-title {
  flex: 1;
  font-size: 38rpx;
  color: #111111;
  font-weight: 700;
  text-align: center;
}

.capsule {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 144rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx #e6e6e6;
  box-sizing: border-box;
}

.capsule-dot,
.capsule-ring {
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
  color: #111111;
}

.product-head-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 18rpx;
  background: #ffffff;
}

.product-head-copy {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.product-head-title {
  font-size: 34rpx;
  line-height: 1.35;
  color: #171717;
  font-weight: 700;
}

.product-head-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #f59e0b;
}

.product-head-cover {
  flex-shrink: 0;
  width: 136rpx;
  height: 136rpx;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 10rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.product-head-cover-image {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.product-head-cover-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 10rpx;
  box-sizing: border-box;
}

.product-head-cover-red {
  background: linear-gradient(135deg, #ff3b30 0%, #bc0000 100%);
}

.product-head-cover-blue {
  background: linear-gradient(135deg, #2f7dff 0%, #1744b5 100%);
}

.product-head-cover-gray {
  background: linear-gradient(135deg, #b9bec9 0%, #7c8597 100%);
}

.product-head-cover-green {
  background: linear-gradient(135deg, #3cc980 0%, #0d8a4d 100%);
}

.product-head-cover-top {
  font-size: 18rpx;
  opacity: 0.88;
}

.product-head-cover-text {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.1;
}

.notice-bar {
  display: flex;
  flex-direction: column;
  padding: 10rpx 18rpx;
  background: #ff9500;
}

.notice-line {
  font-size: 24rpx;
  line-height: 1.6;
  color: #ffffff;
}

.section-title {
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  color: #666666;
  background: #f2f2f2;
}

.form-card {
  background: #ffffff;
}

.field-row,
.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.payout-row-wrap {
  position: relative;
}

.field-row-clickable {
  position: relative;
  z-index: 2;
}

.field-label,
.option-label {
  font-size: 30rpx;
  color: #3a3a3a;
}

.field-value-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.field-value {
  font-size: 28rpx;
  color: #333333;
}

.field-input {
  width: 100%;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.field-input-placeholder {
  color: #c8c8c8;
}

.field-value-placeholder {
  color: #c8c8c8;
}

.field-chip {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.field-chip-alipay {
  background: #e7f5ff;
  color: #1677ff;
}

.field-chip-wechat {
  background: #eaf9ef;
  color: #1f9d55;
}

.field-arrow {
  font-size: 24rpx;
  color: #777777;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 0.2s ease;
}

.field-arrow-open {
  transform: rotate(180deg);
}

.payout-dropdown {
  padding: 8rpx 24rpx 16rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.payout-option {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 12rpx 0;
}

.payout-option-text {
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666666;
  background: #f5f6f8;
}

.payout-option-text-active {
  color: #1f9d55;
  background: #eaf9ef;
  font-weight: 700;
}

.option-card {
  margin-bottom: 20rpx;
}

.photo-card {
  padding: 20rpx 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.photo-helper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.photo-helper-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8d8d8d;
}

.photo-count {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #2536c9;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.photo-item,
.photo-upload-card {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 18rpx;
  overflow: hidden;
}

.photo-item {
  background: #f3f4f6;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(17, 17, 17, 0.72);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
}

.photo-upload-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d8dbe3;
  background: #fafbff;
  color: #3d4ce0;
}

.photo-upload-plus {
  font-size: 68rpx;
  line-height: 1;
}

.photo-upload-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5b6476;
}

.device-option-group {
  background: #ffffff;
}

.option-label {
  font-size: 32rpx;
  color: #2536c9;
}

.option-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 20rpx;
}

.option-selected-text {
  max-width: 360rpx;
  font-size: 32rpx;
  line-height: 1.4;
  color: #a3a3a3;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-arrow {
  font-size: 28rpx;
  color: #555555;
  line-height: 1;
  transition: transform 0.2s ease;
}

.option-arrow-open {
  transform: rotate(180deg);
}

.option-dropdown {
  background: #ffffff;
}

.option-choice {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 20rpx;
  min-height: 86rpx;
  padding: 18rpx 24rpx;
  border-top: 1rpx solid #f3f3f3;
  box-sizing: border-box;
  position: relative;
}

.option-choice-with-images {
  min-height: 236rpx;
}

.option-choice-images {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 10rpx;
  width: 200rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}

.option-choice-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: #f3f4f6;
}

.option-choice-main {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.option-choice-radio {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.option-choice-radio-active {
  border-color: #2536c9;
  box-shadow: inset 0 0 0 6rpx #2536c9;
}

.option-choice-text {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 1.6;
  color: #4a4a4a;
  text-align: left;
}

.option-choice-text-active {
  color: #2536c9;
}

.bottom-space {
  height: 140rpx;
}

.footer-bar {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #ececec;
}

.confirm-button {
  width: 220rpx;
  height: 72rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #16b24a;
  color: #ffffff;
  font-size: 30rpx;
  border: none;
  text-align: center;
}

.confirm-button::after {
  border: none;
}
