page {
  height: 100%;
  background: #ffffff;
  color: #1a1a1a;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.status-holder {
  width: 100%;
}

.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx 20rpx;
  background: #ffffff;
}

.nav-left {
  min-width: 96rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 38rpx;
  font-weight: 700;
  color: #21242b;
}

.nav-right-spacer {
  width: 144rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.content {
  flex: 1;
  min-height: 0;
  padding-top: 28rpx;
  background: #ffffff;
}

.section-card {
  margin: 0 24rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.1);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
}

.setting-item + .setting-item {
  border-top: 1rpx solid #f0f1f4;
}

.setting-label {
  font-size: 34rpx;
  color: #2b313a;
}

.setting-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
}
