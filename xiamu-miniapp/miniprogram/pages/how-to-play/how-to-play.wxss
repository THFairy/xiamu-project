page {
  height: 100%;
  background: linear-gradient(180deg, #fff8e8 0%, #f6f1e5 34%, #ffffff 100%);
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: transparent;
}

.status-holder {
  width: 100%;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx 20rpx;
  flex-shrink: 0;
}

.nav-left,
.nav-right {
  min-width: 96rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: #111111;
  font-weight: 700;
}

.content {
  flex: 1;
  padding: 20rpx 24rpx 36rpx;
  box-sizing: border-box;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx 38rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ff3b30 0%, #d91f13 52%, #7a120c 100%);
  box-shadow: 0 20rpx 48rpx rgba(185, 39, 24, 0.22);
}

.hero-card::after {
  content: '';
  position: absolute;
  top: -70rpx;
  right: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-eyebrow,
.hero-title,
.hero-desc {
  position: relative;
  z-index: 1;
  display: block;
}

.hero-eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 244, 232, 0.8);
}

.hero-title {
  margin-top: 18rpx;
  font-size: 46rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #ffffff;
}

.hero-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.88);
}

.section-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.section-card {
  padding: 28rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 32rpx rgba(17, 17, 17, 0.06);
}

.section-index,
.section-title,
.section-desc {
  display: block;
}

.section-index {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #c96b2c;
}

.section-title {
  margin-top: 10rpx;
  font-size: 32rpx;
  line-height: 1.35;
  color: #1b1f27;
  font-weight: 700;
}

.section-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.75;
  color: #636b79;
}
