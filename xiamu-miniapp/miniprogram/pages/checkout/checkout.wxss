page {
  height: 100%;
  background: #ffffff;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #ffffff;
}

.status-holder {
  width: 100%;
  background: #ffffff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx 20rpx;
  background: #ffffff;
}

.nav-left,
.nav-right {
  min-width: 96rpx;
  display: flex;
  align-items: center;
}

.nav-right {
  justify-content: flex-end;
}

.nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.page-scroll {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.formula-card,
.summary-card,
.item-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.formula-card {
  padding: 28rpx 24rpx;
}

.formula-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.formula-text {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
}

.formula-helper {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8b8b8b;
}

.summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 24rpx;
}

.summary-main {
  display: flex;
  flex-direction: column;
}

.summary-label {
  font-size: 24rpx;
  color: #8b8b8b;
}

.summary-value {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #202631;
}

.summary-total {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ff5b52;
}

.item-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.item-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.item-cover {
  width: 108rpx;
  height: 108rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.item-cover-red {
  background: linear-gradient(135deg, #ff3b30 0%, #bc0000 100%);
}

.item-cover-blue {
  background: linear-gradient(135deg, #2f7dff 0%, #1744b5 100%);
}

.item-cover-gray {
  background: linear-gradient(135deg, #b9bec9 0%, #7c8597 100%);
}

.item-cover-green {
  background: linear-gradient(135deg, #3cc980 0%, #0d8a4d 100%);
}

.item-cover-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

.item-cover-image {
  width: 100%;
  height: 100%;
}

.item-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-delete-button {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  align-self: flex-start;
}

.item-delete-icon {
  width: 34rpx;
  height: 34rpx;
}

.item-title {
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #202631;
}

.item-subtitle,
.item-meta,
.price-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a92a3;
}

.price-block {
  margin-top: 26rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8f9fb;
}

.price-row,
.breakdown-row,
.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-label,
.section-title,
.result-label {
  font-size: 26rpx;
  color: #333333;
}

.price-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f9d55;
}

.breakdown-section {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fafafa;
}

.section-title {
  display: block;
  margin-bottom: 14rpx;
  font-weight: 700;
}

.breakdown-row + .breakdown-row {
  margin-top: 10rpx;
}

.breakdown-label {
  font-size: 24rpx;
  color: #5b5b5b;
}

.breakdown-value,
.result-value {
  font-size: 24rpx;
  color: #ff5b52;
}

.breakdown-row-empty .breakdown-label,
.breakdown-row-empty .breakdown-value {
  color: #999999;
}

.result-card {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #fff4ef 0%, #fff0ee 100%);
}

.result-row + .result-row {
  margin-top: 12rpx;
}

.result-row-final {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #ffd7cc;
}

.result-final {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff5b52;
}

.unsupported-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff7ed;
}

.unsupported-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #b45309;
}

.empty-area {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8b8b8b;
}

.bottom-space {
  height: 168rpx;
}

.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0 calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eceef3;
  flex-shrink: 0;
}

.bottom-action-button {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  border: none;
}

.bottom-action-button::after {
  border: none;
}

.bottom-action-secondary {
  min-width: 220rpx;
  padding: 0 28rpx;
  background: #ffffff;
  color: #222222;
  box-shadow: inset 0 0 0 2rpx #1f1f1f;
}

.bottom-action-primary {
  width: 520rpx;
  background: #111111;
  color: #ffffff;
}
