page {
  height: 100%;
  background: #ffffff;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.status-holder {
  width: 100%;
  background: #ffffff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx 20rpx;
  background: #ffffff;
}

.nav-left {
  min-width: 96rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
  color: #111111;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.content {
  padding: 20rpx 24rpx 40rpx;
}

.summary-card,
.detail-card {
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(29, 35, 48, 0.05);
}

.summary-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.summary-cover {
  width: 108rpx;
  height: 108rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.summary-cover-red {
  background: linear-gradient(135deg, #ff3b30 0%, #bc0000 100%);
}

.summary-cover-blue {
  background: linear-gradient(135deg, #2f7dff 0%, #1744b5 100%);
}

.summary-cover-gray {
  background: linear-gradient(135deg, #b9bec9 0%, #7c8597 100%);
}

.summary-cover-green {
  background: linear-gradient(135deg, #3cc980 0%, #0d8a4d 100%);
}

.summary-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.summary-title {
  font-size: 32rpx;
  line-height: 1.35;
  color: #202631;
  font-weight: 700;
}

.summary-status {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #1fa45f;
  font-weight: 700;
}

.detail-card {
  margin-top: 20rpx;
  padding: 12rpx 24rpx;
}

.detail-section-title {
  display: block;
  padding: 20rpx 0 8rpx;
  font-size: 30rpx;
  color: #111111;
  font-weight: 700;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.detail-row-last {
  border-bottom: none;
}

.detail-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 28rpx;
  color: #2b313a;
}

.detail-value-wrap,
.detail-multiline-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  gap: 18rpx;
}

.detail-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  line-height: 1.6;
  color: #50555f;
  word-break: break-all;
}

.detail-value-multiline {
  text-align: left;
}

.detail-copy {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #2f7dff;
  font-weight: 700;
}
