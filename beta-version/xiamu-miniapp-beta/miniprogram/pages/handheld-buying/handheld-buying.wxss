page {
  height: 100%;
  background: #ffffff;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.status-holder {
  width: 100%;
  background: #ffffff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #ffffff;
}

.nav-left {
  width: 144rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  border-left: 4rpx solid #111111;
  border-top: 4rpx solid #111111;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.nav-title {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  color: #111111;
}

.capsule {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 144rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx #e6e6e6;
  box-sizing: border-box;
}

.capsule-dot,
.capsule-ring {
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
  color: #111111;
}

.device-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.device-tabs {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.device-tab {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: transparent;
}

.device-tab-active {
  background: #000000;
}

.device-tab-text {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.device-tab-text-active {
  color: #ffffff;
  font-weight: 700;
}

.order-entry {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.order-entry-icon {
  font-size: 24rpx;
  color: #969696;
}

.order-entry-text {
  font-size: 30rpx;
  color: #333333;
}

.search-bar {
  display: flex;
  align-items: center;
  margin: 14rpx 24rpx;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #eef0f4;
  color: #a2a7b1;
}

.search-icon-image {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  margin-right: 14rpx;
}

.search-placeholder {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #a2a7b1;
}

.content-area {
  flex: 1;
  display: flex;
  min-height: 0;
}

.brand-panel {
  width: 180rpx;
  background: #f0f0f0;
}

.brand-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 18rpx;
  background: #f0f0f0;
  border-bottom: 1rpx solid #e8e8e8;
  box-sizing: border-box;
}

.brand-item-active {
  background: #ffffff;
}

.brand-text {
  font-size: 30rpx;
  color: #3a3a3a;
  line-height: 1.4;
}

.brand-text-active {
  color: #1f1f1f;
}

.product-panel {
  flex: 1;
  min-width: 0;
  background: #ffffff;
}

.product-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 18rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-cover {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  border-radius: 10rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.product-cover-image {
  width: 100%;
  height: 100%;
  display: block;
}

.product-cover-red {
  background: linear-gradient(135deg, #ff3b30 0%, #b60000 100%);
}

.product-cover-blue {
  background: linear-gradient(135deg, #2f7dff 0%, #1744b5 100%);
}

.product-cover-gray {
  background: linear-gradient(135deg, #b9bec9 0%, #7c8597 100%);
}

.product-cover-green {
  background: linear-gradient(135deg, #3cc980 0%, #0d8a4d 100%);
}

.product-cover-label {
  padding: 0 8rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-title {
  font-size: 34rpx;
  line-height: 1.4;
  color: #2d2d2d;
}

.product-price-block {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.product-price {
  font-size: 40rpx;
  line-height: 1.1;
  color: #e92b2b;
}

.product-hint {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #c4c4c4;
}

.product-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  padding: 40rpx 24rpx;
  box-sizing: border-box;
}

.product-empty-text {
  font-size: 28rpx;
  color: #a0a0a0;
}
