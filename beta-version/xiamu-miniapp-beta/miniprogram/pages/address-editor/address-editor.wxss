page {
  height: 100%;
  background: #ffffff;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.status-holder {
  width: 100%;
  background: #ffffff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #ffffff;
}

.nav-left {
  min-width: 96rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 40rpx;
  height: 40rpx;
  margin-left: 4rpx;
}

.nav-title {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  color: #111111;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.content {
  padding: 20rpx 20rpx 160rpx;
}

.map-panel {
  overflow: hidden;
  border-radius: 16rpx;
  background: #f5f7fc;
}

.form-card {
  margin-top: 20rpx;
  padding: 0 24rpx;
  background: #ffffff;
}

.form-group {
  padding: 26rpx 0 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-group-last {
  border-bottom: none;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 28rpx;
  color: #202020;
}

.required-mark {
  color: #df3e3e;
  font-size: 30rpx;
  line-height: 1;
}

.form-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9aa3b2;
}

.form-input,
.form-textarea {
  width: 100%;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f5f7fc;
  font-size: 28rpx;
  color: #222222;
  box-sizing: border-box;
}

.region-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 92rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f5f7fc;
  color: #222222;
  font-size: 28rpx;
  box-sizing: border-box;
}

.region-picker-placeholder {
  color: #b7bfcc;
}

.region-picker-arrow {
  flex-shrink: 0;
  color: #9aa3b2;
  font-size: 30rpx;
}

.location-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 92rpx;
  margin: 0;
  padding: 0 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.location-picker-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #4a5260;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-map {
  width: 100%;
  height: 400rpx;
}

.form-input {
  height: 92rpx;
  line-height: 92rpx;
}

.form-textarea {
  min-height: 190rpx;
  padding-top: 22rpx;
  padding-bottom: 94rpx;
  line-height: 1.7;
}

.form-placeholder {
  color: #b7bfcc;
}

.bottom-bar {
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #ececec;
}

.submit-button {
  width: 420rpx;
  height: 82rpx;
  line-height: 82rpx;
  margin: 0 auto;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.submit-button-disabled {
  background: #111111;
  color: #ffffff;
  opacity: 0.45;
}

.submit-button::after {
  border: none;
}
